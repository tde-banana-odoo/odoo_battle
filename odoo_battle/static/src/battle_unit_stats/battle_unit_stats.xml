<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="odoo_battle.BattleUnitStats">
        <table class="text-center" t-att-class="this.props.compact ? 'o_battle_unit_stats_compact small' : 'o_battle_unit_stats my-3'">
            <tr>
                <th t-foreach="this.stats" t-as="stat" t-key="stat_index"
                    t-att-class="{ o_battle_unit_stats_sep: stat.separator }" t-att-title="stat.title" t-out="stat.label"/>
            </tr>
            <tr>
                <td t-foreach="this.stats" t-as="stat" t-key="stat_index" t-att-class="{ o_battle_unit_stats_sep: stat.separator }">
                    <input t-if="!stat.separator and !this.props.readonly" type="number" class="o_input"
                        t-att-name="stat.name" t-att-value="stat.value" t-on-change="(ev) => this.onChange(stat.name, ev)"/>
                    <t t-else="" t-out="stat.value"/>
                </td>
            </tr>
        </table>
    </t>

</templates>
