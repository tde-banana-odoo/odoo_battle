<?xml version="1.0"?>
<odoo>
    <record id="battle_trait_view_form" model="ir.ui.view">
        <field name="name">battle.trait.view.form</field>
        <field name="model">battle.trait</field>
        <field name="arch" type="xml">
            <form string="Trait">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Fury"/></h1>
                    </div>
                    <group>
                        <group string="When">
                            <field name="target" widget="radio" options="{'horizontal': true}"/>
                            <field name="side" invisible="target == 'unit'"/>
                            <field name="stance"/>
                            <field name="position" invisible="target == 'location'"/>
                            <field name="condition" readonly="effect == 'bonus'"/>
                        </group>
                        <group string="Effect">
                            <field name="effect"/>
                            <field name="value" invisible="effect == 'lore'"/>
                            <field name="is_unique" invisible="effect == 'lore'"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Lore, rules details..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="battle_trait_view_search" model="ir.ui.view">
        <field name="name">battle.trait.view.search</field>
        <field name="model">battle.trait</field>
        <field name="arch" type="xml">
            <search string="Search">
                <field name="name"/>
                <filter name="filter_unit" string="Unit Traits" domain="[('target', '=', 'unit')]"/>
                <filter name="filter_location" string="Location Traits" domain="[('target', '=', 'location')]"/>
                <group>
                    <filter name="groupby_target" string="Target" context="{'group_by': 'target'}"/>
                    <filter name="groupby_effect" string="Effect" context="{'group_by': 'effect'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="battle_trait_view_list" model="ir.ui.view">
        <field name="name">battle.trait.view.list</field>
        <field name="model">battle.trait</field>
        <field name="arch" type="xml">
            <list string="Traits" decoration-muted="effect == 'lore'">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="target"/>
                <field name="side"/>
                <field name="stance"/>
                <field name="position"/>
                <field name="condition"/>
                <field name="effect"/>
                <field name="value"/>
                <field name="is_unique"/>
            </list>
        </field>
    </record>

    <record id="battle_trait_action" model="ir.actions.act_window">
        <field name="name">Traits</field>
        <field name="res_model">battle.trait</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
