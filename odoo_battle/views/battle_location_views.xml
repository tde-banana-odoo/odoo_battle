<?xml version="1.0"?>
<odoo>
    <record id="battle_location_view_form" model="ir.ui.view">
        <field name="name">battle.location.view.form</field>
        <field name="model">battle.location</field>
        <field name="arch" type="xml">
            <form string="Location">
                <header>
                    <button name="%(odoo_battle.battle_solver_action)d" type="action"
                        string="Battle" class="btn-primary"
                        invisible="not battle_unit_ids or is_external"
                        groups="base.group_system"/>
                    <field name="status" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Walkhill"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="held_by_faction_id" invisible="status == 'free'"
                                required="status == 'held'"/>
                            <field name="linked_location_id"/>
                            <field name="battle_trait_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="is_umbra"/>
                            <field name="is_external"/>
                        </group>
                    </group>
                    <field name="battle_unit_ids" readonly="1">
                        <list>
                            <field name="avatar_128" widget="image" options="{'size': [24, 24]}" string=" "/>
                            <field name="name"/>
                            <field name="unit_type"/>
                            <field name="battle_faction_id"/>
                            <widget name="battle_unit_stats" options="{'compact': True}"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="battle_location_view_search" model="ir.ui.view">
        <field name="name">battle.location.view.search</field>
        <field name="model">battle.location</field>
        <field name="arch" type="xml">
            <search string="Search">
                <field name="name"/>
                <field name="held_by_faction_id"/>
                <filter name="filter_free" string="Free" domain="[('status', '=', 'free')]"/>
                <filter name="filter_contested" string="Contested" domain="[('status', '=', 'contested')]"/>
                <filter name="filter_held" string="Held" domain="[('status', '=', 'held')]"/>
                <separator/>
                <filter name="filter_umbra" string="Umbra" domain="[('is_umbra', '=', True)]"/>
                <separator/>
                <filter name="filter_battlefield" string="Battlefield" domain="[('is_external', '=', False)]"/>
                <filter name="filter_external" string="External" domain="[('is_external', '=', True)]"/>
                <group>
                    <filter name="groupby_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="groupby_held_by" string="Held By" context="{'group_by': 'held_by_faction_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="battle_location_view_list" model="ir.ui.view">
        <field name="name">battle.location.view.list</field>
        <field name="model">battle.location</field>
        <field name="arch" type="xml">
            <list string="Locations">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="linked_location_id"/>
                <field name="status" widget="badge"
                    decoration-success="status == 'free'"
                    decoration-warning="status == 'contested'"
                    decoration-info="status == 'held'"/>
                <field name="held_by_faction_id"/>
                <field name="battle_trait_ids" widget="many2many_tags"/>
                <field name="is_umbra" optional="show"/>
                <field name="is_external" optional="show"/>
            </list>
        </field>
    </record>

    <record id="battle_location_action" model="ir.actions.act_window">
        <field name="name">Locations</field>
        <field name="res_model">battle.location</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
