<?xml version="1.0"?>
<odoo>
    <record id="battle_unit_template_view_form" model="ir.ui.view">
        <field name="name">battle.unit.template.view.form</field>
        <field name="model">battle.unit.template</field>
        <field name="arch" type="xml">
            <form string="Unit Template">
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'avatar_128'}"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Offense Werewolves Rank 3"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="unit_type"/>
                        </group>
                    </group>
                    <widget name="battle_unit_stats"/>
                    <group>
                        <field name="battle_trait_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                    <field name="battle_unit_ids" readonly="1">
                        <list>
                            <field name="avatar_128" widget="image" options="{'size': [24, 24]}" string=" "/>
                            <field name="name"/>
                            <field name="battle_faction_id"/>
                            <field name="battle_location_id"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="battle_unit_template_view_list" model="ir.ui.view">
        <field name="name">battle.unit.template.view.list</field>
        <field name="model">battle.unit.template</field>
        <field name="arch" type="xml">
            <list string="Unit Templates">
                <field name="sequence" widget="handle"/>
                <field name="avatar_128" widget="image" options="{'size': [24, 24]}" string=" "/>
                <field name="name"/>
                <field name="unit_type"/>
                <widget name="battle_unit_stats" options="{'compact': True}"/>
                <field name="battle_trait_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="battle_unit_template_action" model="ir.actions.act_window">
        <field name="name">Unit Templates</field>
        <field name="res_model">battle.unit.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
