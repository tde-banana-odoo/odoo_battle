<?xml version="1.0"?>
<odoo>
    <record id="battle_leader_view_form" model="ir.ui.view">
        <field name="name">battle.leader.view.form</field>
        <field name="model">battle.leader</field>
        <field name="arch" type="xml">
            <form string="Leader">
                <header>
                    <field name="narrative_state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'avatar_128'}"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Calamity Jane"/></h1>
                        <span class="badge text-bg-warning" invisible="not is_faction_leader">Faction Leader</span>
                    </div>
                    <group>
                        <group>
                            <field name="unit_type"/>
                            <field name="battle_faction_id"/>
                            <field name="battle_location_id"/>
                        </group>
                        <group>
                            <field name="wound_state"/>
                            <field name="is_champion"/>
                            <field name="is_faction_leader" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="battle_leader_view_search" model="ir.ui.view">
        <field name="name">battle.leader.view.search</field>
        <field name="model">battle.leader</field>
        <field name="arch" type="xml">
            <search string="Search">
                <field name="name"/>
                <field name="battle_faction_id"/>
                <field name="battle_location_id"/>
                <filter name="filter_faction_leader" string="Faction Leaders" domain="[('is_faction_leader', '=', True)]"/>
                <filter name="filter_champion" string="Champions" domain="[('is_champion', '=', True)]"/>
                <separator/>
                <filter name="filter_wounded" string="Wounded" domain="[('wound_state', '!=', '4')]"/>
                <group>
                    <filter name="groupby_faction" string="Faction" context="{'group_by': 'battle_faction_id'}"/>
                    <filter name="groupby_narrative_state" string="Narrative Status" context="{'group_by': 'narrative_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="battle_leader_view_list" model="ir.ui.view">
        <field name="name">battle.leader.view.list</field>
        <field name="model">battle.leader</field>
        <field name="arch" type="xml">
            <list string="Leaders" decoration-muted="narrative_state in ('dead', 'mia')" decoration-bf="is_faction_leader">
                <field name="is_faction_leader" column_invisible="1"/>
                <field name="avatar_128" widget="image" options="{'size': [24, 24]}" string=" "/>
                <field name="name"/>
                <field name="unit_type" optional="show"/>
                <field name="is_champion" optional="show"/>
                <field name="battle_faction_id"/>
                <field name="battle_location_id"/>
                <field name="wound_state" widget="badge" width="115px"
                    decoration-success="wound_state == '4'" decoration-warning="wound_state in ('3', '2')"
                    decoration-danger="wound_state in ('1', '0')"/>
                <field name="narrative_state" widget="badge"
                    decoration-success="narrative_state == 'alive'" decoration-warning="narrative_state == 'routing'"
                    decoration-danger="narrative_state == 'dead'"/>
            </list>
        </field>
    </record>

    <record id="battle_leader_action" model="ir.actions.act_window">
        <field name="name">Leaders</field>
        <field name="res_model">battle.leader</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
