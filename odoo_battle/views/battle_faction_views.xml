<?xml version="1.0"?>
<odoo>
    <record id="battle_faction_view_form" model="ir.ui.view">
        <field name="name">battle.faction.view.form</field>
        <field name="model">battle.faction</field>
        <field name="arch" type="xml">
            <form string="Faction">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Loch Chon"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="leader_id"/>
                            <field name="role"/>
                            <field name="allied_faction_id" invisible="role != 'neutral'"
                                domain="[('id', '!=', id), ('role', '!=', 'neutral')]"/>
                        </group>
                        <group>
                            <field name="morale"/>
                        </group>
                    </group>
                    <field name="battle_unit_ids" readonly="1">
                        <list decoration-muted="is_dead" decoration-it="is_dead">
                            <field name="is_dead" column_invisible="1"/>
                            <field name="avatar_128" widget="image" options="{'size': [24, 24]}" string=" "/>
                            <field name="name"/>
                            <field name="unit_type"/>
                            <field name="battle_location_id"/>
                            <widget name="battle_unit_stats" options="{'compact': True}"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="battle_faction_view_search" model="ir.ui.view">
        <field name="name">battle.faction.view.search</field>
        <field name="model">battle.faction</field>
        <field name="arch" type="xml">
            <search string="Search">
                <field name="name"/>
                <field name="leader_id"/>
            </search>
        </field>
    </record>

    <record id="battle_faction_view_list" model="ir.ui.view">
        <field name="name">battle.faction.view.list</field>
        <field name="model">battle.faction</field>
        <field name="arch" type="xml">
            <list string="Factions">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="leader_id"/>
                <field name="role"/>
                <field name="allied_faction_id"/>
                <field name="morale"/>
                <field name="battle_unit_count"/>
            </list>
        </field>
    </record>

    <record id="battle_faction_action" model="ir.actions.act_window">
        <field name="name">Factions</field>
        <field name="res_model">battle.faction</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
