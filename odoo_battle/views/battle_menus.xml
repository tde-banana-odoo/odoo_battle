<?xml version="1.0"?>
<odoo>
    <menuitem id="battle_menu_root" name="LG Battle"
        action="odoo_battle.battle_dashboard_action"
        groups="base.group_user_regular"
        web_icon="odoo_battle,static/img/beastmen.png"
        sequence="5">
        <menuitem id="battle_dashboard_menu" name="Dashboard" action="odoo_battle.battle_dashboard_action" sequence="0"/>
        <menuitem id="battle_unit_menu_head" name="Units" sequence="10">
            <menuitem id="battle_unit_menu" name="Units" action="odoo_battle.battle_unit_action" sequence="10"/>
            <menuitem id="battle_faction_menu" name="Factions" action="odoo_battle.battle_faction_action" sequence="20"/>
            <menuitem id="battle_leader_menu" name="Leaders" action="odoo_battle.battle_leader_action" sequence="30"/>
        </menuitem>
        <menuitem id="battle_location_menu" name="Locations" action="odoo_battle.battle_location_action" sequence="20"/>
        <menuitem id="battle_menu_head" name="Battles" sequence="30">
            <menuitem id="battle_round_menu" name="Rounds" action="odoo_battle.battle_round_action" sequence="10"/>
            <menuitem id="battle_result_menu" name="Results" action="odoo_battle.battle_result_action" sequence="20"/>
            <menuitem id="battle_solver_menu" name="Solver" action="odoo_battle.battle_solver_action" groups="base.group_system" sequence="30"/>
        </menuitem>
        <menuitem id="battle_config_menu_head" name="Configuration" groups="base.group_system" sequence="100">
            <menuitem id="battle_trait_menu" name="Traits" action="odoo_battle.battle_trait_action" sequence="10"/>
            <menuitem id="battle_outcome_menu" name="Outcomes" action="odoo_battle.battle_outcome_action" sequence="20"/>
            <menuitem id="battle_unit_template_menu" name="Unit Templates" action="odoo_battle.battle_unit_template_action" sequence="30"/>
            <menuitem id="battle_unit_sheet_wizard_menu" name="Print Blank Sheets" action="odoo_battle.battle_unit_sheet_wizard_action" sequence="40"/>
            <menuitem id="battle_rules_reference_menu" name="Print Rules Reference" action="odoo_battle.action_report_rules_reference" sequence="50"/>
            <menuitem id="battle_traits_reference_menu" name="Print Traits Reference" action="odoo_battle.action_report_traits_reference" sequence="60"/>
        </menuitem>
    </menuitem>
</odoo>
