<?xml version="1.0"?>
<odoo>
    <record id="battle_result_view_form" model="ir.ui.view">
        <field name="name">battle.result.view.form</field>
        <field name="model">battle.result</field>
        <field name="arch" type="xml">
            <form string="Battle Result" create="0" edit="0">
                <header>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state == 'cancel'"
                        confirm="Cancel this result? The battle can then be solved again for this round."/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="battle_outcome_id" options="{'no_open': True}"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="battle_round_id"/>
                            <field name="battle_location_id"/>
                        </group>
                        <group>
                            <field name="dice_roll"/>
                            <field name="bonus"/>
                            <field name="result_score"/>
                        </group>
                        <group string="Initiators">
                            <field name="initiator_faction_ids" string="Factions" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <field name="initiator_stance" string="Stance"/>
                            <field name="damage_to_initiators" string="Damage Taken"/>
                        </group>
                        <group string="Responders">
                            <field name="responder_faction_ids" string="Factions" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <field name="responder_stance" string="Stance"/>
                            <field name="damage_to_responders" string="Damage Taken"/>
                        </group>
                    </group>
                    <field name="battle_result_line_ids">
                        <list decoration-muted="position == 'support'">
                            <field name="side"/>
                            <field name="battle_unit_id" widget="many2one_avatar"/>
                            <field name="position"/>
                            <field name="wound_state_before" string="Before" widget="badge"
                                decoration-success="wound_state_before == '4'" decoration-warning="wound_state_before in ('3', '2')"
                                decoration-danger="wound_state_before in ('1', '0')"/>
                            <field name="damage_counter_before" string="Dmg Before"/>
                            <field name="damage"/>
                            <field name="wounds" decoration-danger="wounds &gt; 0" decoration-success="wounds &lt; 0"/>
                        </list>
                    </field>
                    <field name="battle_location_effect_ids" invisible="not battle_location_effect_ids">
                        <list>
                            <field name="battle_faction_id"/>
                            <field name="battle_trait_id"/>
                            <field name="round_number"/>
                        </list>
                    </field>
                    <field name="result_message"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="battle_result_view_search" model="ir.ui.view">
        <field name="name">battle.result.view.search</field>
        <field name="model">battle.result</field>
        <field name="arch" type="xml">
            <search string="Search">
                <field name="battle_round_id"/>
                <field name="battle_location_id"/>
                <field name="initiator_faction_ids" string="Faction" filter_domain="['|', ('initiator_faction_ids', 'in', raw_value), ('responder_faction_ids', 'in', raw_value)]"/>
                <filter name="filter_done" string="Done" domain="[('state', '=', 'done')]"/>
                <group>
                    <filter name="groupby_round" string="Round" context="{'group_by': 'battle_round_id'}"/>
                    <filter name="groupby_location" string="Location" context="{'group_by': 'battle_location_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="battle_result_view_list" model="ir.ui.view">
        <field name="name">battle.result.view.list</field>
        <field name="model">battle.result</field>
        <field name="arch" type="xml">
            <list string="Battle Results" create="0" decoration-muted="state == 'cancel'">
                <field name="battle_round_id"/>
                <field name="battle_location_id"/>
                <field name="initiator_faction_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="responder_faction_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="result_score" decoration-success="result_score &gt; 0" decoration-danger="result_score &lt; 0"/>
                <field name="battle_outcome_id" decoration-success="result_score &gt; 0" decoration-danger="result_score &lt; 0"/>
                <field name="damage_to_responders" optional="show"/>
                <field name="damage_to_initiators" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="battle_result_action" model="ir.actions.act_window">
        <field name="name">Battle Results</field>
        <field name="res_model">battle.result</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_done': 1}</field>
    </record>
</odoo>
