    <!-- Realm / Umbra links (reverse link is set automatically) -->
    <record id="battle_location_hills" model="battle.location">
        <field name="linked_location_id" ref="battle_location_hills_umbra"/>
    </record>
    <record id="battle_location_bois" model="battle.location">
        <field name="linked_location_id" ref="battle_location_bois_umbra"/>
    </record>
    <record id="battle_location_loch_chon" model="battle.location">
