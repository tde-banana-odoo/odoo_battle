<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="battle_location_enclos" model="battle.location">
        <field name="name">Enclos</field>
        <field name="is_umbra" eval="True"/>
        <field name="sequence">5</field>
        <field name="status">held</field>
        <field name="held_by_faction_id" ref="battle_faction_kiker"/>
    </record>
    <record id="battle_location_hills" model="battle.location">
        <field name="name">Hills</field>
        <field name="sequence">10</field>
        <field name="battle_trait_ids" eval="[Command.set([
            ref('battle_trait_fortified'),
            ref('battle_trait_tagged'),
            ref('battle_trait_resupplied'),
        ])]"/>
        <field name="status">contested</field>
    </record>
    <record id="battle_location_hills_umbra" model="battle.location">
        <field name="name">Hills (Umbra)</field>
        <field name="sequence">15</field>
        <field name="is_umbra" eval="True"/>
        <field name="battle_trait_ids" eval="[Command.set([
            ref('battle_trait_dangerous'),
])]"/>
        <field name="status">contested</field>
    </record>
    <record id="battle_location_stronachlachar" model="battle.location">
        <field name="name">Stronachlachar</field>
        <field name="sequence">20</field>
        <field name="battle_trait_ids" eval="[Command.set([
            ref('battle_trait_fortified'),
        ])]"/>
        <field name="status">held</field>
        <field name="held_by_faction_id" ref="battle_faction_loch_chon"/>
    </record>
